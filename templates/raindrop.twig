---
title: "{% if title|length > title_length %}{{ title|slice(0,title_length)|raw }}...{% else %}{{ title|raw }}{% endif %}"
date: {{ date }}
icon: bookmark
source: Bookmarks
src_url: {{ url }}
domains:
- {{ host }}
{{ year }}: "{{ month }}"
{% if categories|length > 0 or tags|length > 0 %}categories:
{% for category in categories %}
- {{ category }}
{% endfor %}
{% for tag in tags %}
    - "{{ tag }}"
{% endfor %}
{% endif %}
